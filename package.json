    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "20.3.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "prettier": "^2.8.8",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.1.0"
  },
  "comments": {
    "cim-ui-components": "Not wired up yet — this shell currently uses local placeholder components (see src/shell) that follow the same status-badge / card conventions described in CLAUDE.md. Swap in the real cim-ui-components package once its v19-React build is confirmed, per governance's shared design-system item.",
    "@originjs/vite-plugin-federation": "Chosen as the Module Federation runtime for Vite. Validate against org standards before locking in — proposal section 5 flags the plugin/runtime as needing selection + validation."
  }
}
