{
  "name": "cim-shell",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:production": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "build:qa": "vite build --mode qa",
    "start": "npx serve dist -p 3000",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,d.ts}\"",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.3",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.52.2",
    "axios": "^1.6.7",
    "cim-ui-components": "1.1.4",
    "cookie": "^1.0.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.562.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.1.1",
    "react-router": "^7.5.3",
    "react-router-dom": "^7.5.3",
    "redux": "^5.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@module-federation/vite": "^1.22.1",
